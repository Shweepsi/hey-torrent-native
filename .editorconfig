# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yml,yaml,json,xml,toml,xcconfig,xcstrings}]
indent_size = 2

# Les scripts shell du dépôt sont indentés sur 2 espaces.
[*.sh]
indent_size = 2

# En Markdown, deux espaces en fin de ligne peuvent être un saut de ligne voulu.
[*.md]
trim_trailing_whitespace = false

[{gradlew.bat,*.bat}]
end_of_line = crlf

[Makefile]
indent_style = tab
